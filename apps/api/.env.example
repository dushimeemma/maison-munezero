DATABASE_URL=postgresql://maison:YOUR_PASSWORD@localhost:5432/maison
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:8080
DB_SSL=false
ADMIN_EMAIL=admin@maisonmunezero.example
ADMIN_PASSWORD=
SEED_SAMPLE_DATA=true
# Flutterwave v3 secret key, from the dashboard in the matching mode.
FLUTTERWAVE_MODE=test
FLUTTERWAVE_SECRET_KEY=
# Set this same random secret hash on the Flutterwave webhook dashboard.
FLUTTERWAVE_WEBHOOK_SECRET=
# Optional: retain only while reconciling MTN payments created before the switch.
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_TARGET_ENVIRONMENT=sandbox
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
MOMO_CALLBACK_BASE=
# Hosted email over HTTPS: set EMAIL_PROVIDER=brevo. SMTP remains the local default.
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Maison Munezero
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
